{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    // Match the runtime the tests execute under: vite-plugin-solid injects the
    // browser/development conditions in test mode, and solid-js maps the bare
    // node condition to the inert server build.
    "customConditions": ["browser", "development"]
  },
  "include": ["src", "eslint.config.js", "vite.config.ts", "tests"]
}
